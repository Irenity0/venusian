{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "strictNullChecks": true,
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/*": ["./src/*"],
      "@components/*": ["./src/components/*"],
      "@layouts/*": ["./src/layouts/*"],
      "@types": ["./src/types/index.ts"],
      "@lib/*": ["./src/lib/*"],
      "@consts": ["./src/consts.ts"]
    },
    "noImplicitAny": false
  }
}